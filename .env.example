# ============================================================================
# Project settings -- NOT secrets.
#
# Credentials do NOT go in this file. They are stored in your OS keyring:
#
#     python -m config.credentials setup
#
# That asks for your moomoo login, password, and RSA key path, stores them in
# Windows Credential Manager (or Keychain / Secret Service), and never writes
# them to disk. Run `python -m config.credentials status` to check, or
# `clear` to remove them.
# ============================================================================

# --- Portfolio tracking -----------------------------------------------------
# The date you started tracking (YYYY-MM-DD). History is fetched from here.
# On an existing database this only matters as the backfill floor.
START_DATE="2024-01-01"

# --- OpenD (only if you use the OpenD gateway) ------------------------------
# Folder containing OpenD.exe. Leave unset to use the default location under
# the project directory. This is a PATH, not a secret.
# OPEND_DIR=C:\Users\YourName\.ssh\moomoo_OpenD_9.6.5618_Windows

# --- Headless / CI only ----------------------------------------------------
# If you cannot use an OS keyring (CI runner, container), set these instead.
# They take effect when no keyring value is present.
# MOOMOO_LOGIN_ACCOUNT=YOUR_LOGIN_ACCOUNT_HERE
# MOOMOO_LOGIN_PWD=YOUR_PASSWORD_HERE
# MOOMOO_RSA_KEY=C:\Users\YourName\.ssh\moomoo_api_private_key.txt
