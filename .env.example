# === Secure Credentials Env Path ===
# Absolute path to the .env file containing your credentials (outside project tree)
MOOMOO_SECRET_ENV=C:\Users\YourName\.ssh\moomoo_creds.env

# === RSA Private Key ===
# Absolute path to your RSA private key file
MOOMOO_RSA_KEY=C:\Users\YourName\.ssh\moomoo_api_private_key.txt

# === Moomoo Login Credentials ===
# Your moomoo login account (user ID, phone, or email)
MOOMOO_LOGIN_ACCOUNT=YOUR_LOGIN_ACCOUNT_HERE
# Your moomoo login password (plain text)
MOOMOO_LOGIN_PWD=YOUR_PASSWORD_HERE

# === OpenD Directory ===
# Path to the moomoo_OpenD folder (outside project tree, to keep credentials safe)
OPEND_DIR=C:\Users\YourName\.ssh\moomoo_OpenD_9.6.5618_Windows

# === Portfolio Tracking ===
# Date you opened your Moomoo account (YYYY-MM-DD)
START_DATE="YYYY-MM-DD"