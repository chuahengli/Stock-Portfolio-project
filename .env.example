# Non-secret settings only. Credentials go in the OS keyring:
#     python -m config.credentials setup

# Date tracking began (YYYY-MM-DD). History backfills from here.
START_DATE="2024-01-01"

# Folder containing OpenD.exe. Optional -- defaults to the project directory.
# OPEND_DIR=C:\Users\YourName\.ssh\moomoo_OpenD_9.6.5618_Windows

# Headless/CI only: used when no keyring value is present.
# MOOMOO_LOGIN_ACCOUNT=
# MOOMOO_LOGIN_PWD=
# MOOMOO_RSA_KEY=C:\Users\YourName\.ssh\moomoo_api_private_key.txt
