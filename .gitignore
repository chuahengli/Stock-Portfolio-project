# Python
__pycache__/
*.pyc
.pytest_cache/

# Environment Variables
.env

# Database (Local storage)
db/

# Moomoo OpenD
# Ignore the actual config file containing credentials
**/OpenD.xml
# Ignore the entire OpenD runtime folder (large binaries, kept on host)
moomoo_OpenD_9.6.5618_Windows/
# But keep the example template (no credentials, safe to version)
!OpenD.example.xml

# Jupyter Notebooks
*.ipynb
/.ipynb_checkpoints/

# Windows Task Scheduler script (machine-specific absolute paths; a
# placeholder template is tracked as run_daily.example.bat)
run_daily.bat

# Daily run logs (rotated archive may be .txt.gz)
daily_log*

# Power BI (generated artifacts - rebuild with source/export_powerbi.py)
powerbi/export/
powerbi/*.pbix
powerbi/symbol_meta.json

# Power BI PBIP machine-local working files (caches, settings, credentials)
**/.pbi/
powerbi/**/StaticResources/
*.abf
# Personal financial artifacts - never publish (report PDF contains real holdings/P&L)
powerbi/PowerBI/Media/*.pdf
