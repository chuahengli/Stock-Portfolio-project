# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# ============================================================================
# Secrets and local configuration
# ============================================================================
# .env holds NON-SECRET config only (START_DATE, OPEND_DIR). Credentials live
# in the OS keyring. Still not committed: it is machine-specific.
.env

# Generated at runtime from OpenD.example.xml + keyring. CONTAINS THE PASSWORD.
OpenD.xml
**/OpenD.xml

# The OpenD binary folder (~100 MB). If installed inside the project, ignore it
# wholesale -- this rule also covers any OpenD.xml generated inside it.
moomoo_OpenD_9.6.5618_Windows/

# ============================================================================
# Local data
# ============================================================================
# SQLite database (personal financial data)
db/
*.db
*.db-shm
*.db-wal
*.db-journal

# Daily run logs
logs/
daily_log*

# ============================================================================
# Machine-local scripts
# ============================================================================
# run_daily.bat embeds this machine's absolute path; run_daily.example.bat is
# the tracked template.
run_daily.bat

# ============================================================================
# Power BI
# ============================================================================
# Generated star-schema CSVs -- rebuild with source/export_powerbi.py
powerbi/export/
powerbi/*.pbix
# yfinance enrichment cache (regenerable)
powerbi/symbol_meta.json

# PBIP machine-local working files: caches, settings, credential blob
**/.pbi/
powerbi/**/StaticResources/
*.abf
# Report PDF contains real holdings and P&L -- never publish
powerbi/PowerBI/Media/*.pdf

# ============================================================================
# Editor / OS / scratch
# ============================================================================
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Local planning and scratch notes
.hermes/
