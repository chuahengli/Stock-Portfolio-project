# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local config. Non-secret only (START_DATE, OPEND_DIR); credentials are in the
# OS keyring. Ignored because it is machine-specific.
.env

# Generated from OpenD.example.xml + keyring at runtime. CONTAINS THE PASSWORD.
OpenD.xml
**/OpenD.xml

# OpenD binary folder (~100 MB)
moomoo_OpenD_9.6.5618_Windows/

# SQLite database -- personal financial data
db/
*.db
*.db-shm
*.db-wal
*.db-journal

# Run logs
logs/
daily_log*

# Embeds this machine's absolute path; template is run_daily.example.bat
run_daily.bat

# Power BI -- generated CSVs, rebuild with source/export_powerbi.py
powerbi/export/
powerbi/*.pbix
powerbi/symbol_meta.json

# Power BI PBIP machine-local files: caches, settings, credential blob
**/.pbi/
powerbi/**/StaticResources/
*.abf
# Report PDF contains real holdings and P&L
powerbi/PowerBI/Media/*.pdf

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

