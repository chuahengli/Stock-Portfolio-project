table fact_positions
	lineageTag: 0c51281c-a4cc-4c42-a78d-99ee8a29d2d4

	measure 'Positions Value' = SUM(fact_positions[Market_Value])
		lineageTag: 0e315a77-5429-43ac-8347-4598e11141c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Allocation =
			
			CALCULATE(
			    VAR LastDataDay = CALCULATE(MAX(fact_positions[Date]), ALL(dim_symbol))
			    RETURN
			        DIVIDE(
			            CALCULATE(SUM(fact_positions[Market_Value]), fact_positions[Date] = LastDataDay),
			            CALCULATE(SUM(fact_positions[Market_Value]), fact_positions[Date] = LastDataDay, ALL(dim_symbol))
			        ),
			    FILTER(ALL(dim_date[Date]), dim_date[Date] >= [WindowStart] && dim_date[Date] <= [Window End])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ad6ed0e5-09b9-44ea-a860-90c0482fae8f

	column Date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 80be4636-e323-4b31-8fa6-592bd5220f4b
