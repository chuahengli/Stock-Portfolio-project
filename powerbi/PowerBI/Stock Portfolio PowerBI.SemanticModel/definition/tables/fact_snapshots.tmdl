table fact_snapshots
	lineageTag: d9f71962-562b-4237-bc5b-1b16f4ebd038

	measure 'Total Assets (all history)' = CALCULATE(SUM(fact_snapshots[total_assets]), ALL(dim_date))
		formatString: 0.00
		lineageTag: a8e30034-90fe-4945-8e1b-4fbd39e066a8

	measure 'Latest Total Assets' =
			
			VAR LatestDay =
			    CALCULATE(
			        MAX(dim_date[Date]),
			        LASTNONBLANK(dim_date[Date], CALCULATE(SUM(fact_snapshots[total_assets]))),
			        FILTER(ALL(dim_date[Date]), dim_date[Date] >= [WindowStart] && dim_date[Date] <= [Window End])
			    )
			RETURN CALCULATE(SUM(fact_snapshots[total_assets]), dim_date[Date] = LatestDay)
		formatString: \$#,0.000;(\$#,0.000);\$#,0.000
		lineageTag: 1eeb9c33-b620-4ae2-b1d6-cc790e892fb4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Stocks Value' = ```
			SUM(fact_snapshots[stocks]) 
			```
		formatString: 0.00
		lineageTag: 10285c0f-93a8-4c3d-925d-e2becec4d362

	measure 'Options Value' = SUM(fact_snapshots[options])
		formatString: 0.00
		lineageTag: e02fc4d0-108e-4b1a-b2d3-3369549ff371

	measure 'Cash Value' = SUM(fact_snapshots[cash])
		formatString: 0.00
		lineageTag: 3ce2e266-ae95-41c8-9a3e-e3201df1a153

	measure 'Component Total' = [Stocks Value] + [Options Value] + [Cash Value]
		formatString: 0.00
		lineageTag: ec8b977e-a356-4fac-9fb6-43d9001013e1

	measure 'Stocks Ratio' =
			
			VAR WindowFilter = FILTER(ALL(dim_date[Date]), dim_date[Date] >= [WindowStart] && dim_date[Date] <= [Window End])
			VAR WindowValue = CALCULATE([Stocks Value], KEEPFILTERS(WindowFilter))
			VAR WindowTotal = CALCULATE([Component Total], KEEPFILTERS(WindowFilter))
			RETURN DIVIDE(WindowValue, WindowTotal)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9b4a4eb3-3eec-4a29-b493-d53b9124bdcb

	measure 'Options Ratio' =
			
			VAR WindowFilter = FILTER(ALL(dim_date[Date]), dim_date[Date] >= [WindowStart] && dim_date[Date] <= [Window End])
			VAR WindowValue = CALCULATE([Options Value], KEEPFILTERS(WindowFilter))
			VAR WindowTotal = CALCULATE([Component Total], KEEPFILTERS(WindowFilter))
			RETURN DIVIDE(WindowValue, WindowTotal)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2cdb4892-2af1-46a4-8de8-00ec506330ba

	measure 'Cash Ratio' =
			
			VAR WindowFilter = FILTER(ALL(dim_date[Date]), dim_date[Date] >= [WindowStart] && dim_date[Date] <= [Window End])
			VAR WindowValue = CALCULATE([Cash Value], KEEPFILTERS(WindowFilter))
			VAR WindowTotal = CALCULATE([Component Total], KEEPFILTERS(WindowFilter))
			RETURN DIVIDE(WindowValue, WindowTotal)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7e69a6a2-1c33-4df3-a227-78a5e6c06f56

	measure 'Portfolio Volatility' =
			
			VAR Win = FILTER(ALL(dim_date[Date]), dim_date[Date] >= [WindowStart] && dim_date[Date] <= [Window End])
			VAR N = CALCULATE(COUNTA(fact_snapshots[Time-Weight Return]), Win)
			VAR FirstD = CALCULATE(MIN(fact_snapshots[Date]), Win)
			VAR LastD = CALCULATE(MAX(fact_snapshots[Date]), Win)
			VAR YearSpan = DIVIDE(DATEDIFF(FirstD, LastD, DAY), 365.25)
			VAR Sd = CALCULATE(STDEVX.P(fact_snapshots, fact_snapshots[Time-Weight Return]), Win)
			RETURN
			    IF(N < 2, BLANK(), Sd * SQRT(DIVIDE(N, YearSpan)))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 28381dff-5b37-4d9c-9e91-6cd3dc88dcff

	measure 'Stocks Ratio AsOf' =
			
			VAR AsOfDay = CALCULATE(MAX(fact_snapshots[Date]), FILTER(ALL(dim_date[Date]), dim_date[Date] >= [WindowStart] && dim_date[Date] <= [Date Anchor]))
			RETURN CALCULATE(DIVIDE([Stocks Value], [Component Total]), fact_snapshots[Date] = AsOfDay)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: efb6b604-f592-47a5-b3e9-809b702cfefd

	measure 'Options Ratio AsOf' =
			
			VAR AsOfDay = CALCULATE(MAX(fact_snapshots[Date]), FILTER(ALL(dim_date[Date]), dim_date[Date] >= [WindowStart] && dim_date[Date] <= [Window End]))
			RETURN CALCULATE(DIVIDE([Options Value], [Component Total]), fact_snapshots[Date] = AsOfDay)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a38fce8f-5dbc-461f-b92c-98e1804ceab9

	measure 'Cash Ratio AsOf' =
			
			VAR AsOfDay = CALCULATE(MAX(fact_snapshots[Date]), FILTER(ALL(dim_date[Date]), dim_date[Date] >= [WindowStart] && dim_date[Date] <= [Window End]))
			RETURN CALCULATE(DIVIDE([Cash Value], [Component Total]), fact_snapshots[Date] = AsOfDay)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e03d68ec-dfb7-4cd0-8c03-a90b7f38303e

