	measure 'Dividend and Interest Income All Time' = ```
			CALCULATE(SUM(fact_cashflow[Amount]), fact_cashflow[CashflowCategory] = "Dividend Income", 
			                            FILTER(ALL(dim_date[Date]), dim_date[Date] <= MAX(dim_date[Date])))
