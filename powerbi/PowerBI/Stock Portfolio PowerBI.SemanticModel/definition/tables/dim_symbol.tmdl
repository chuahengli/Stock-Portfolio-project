	partition dim_symbol = m
		mode: import
		source =
				let
				    Source = Csv.Document(Folder.Files("C:\Users\user\Hermes Workspace\Stock Market, Finance\Stock Portfolio project\powerbi\export"){[Name="dim_symbol.csv"]}[Content],[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None]),
