				then [AssetSubclass]
				else [Sector]),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Industry Class", each if [Industry] = null or Text.Trim([Industry]) = ""
				then [AssetSubclass]
				else [Industry])
				in
