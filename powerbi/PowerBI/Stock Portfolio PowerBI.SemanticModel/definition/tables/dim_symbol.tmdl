				    #"Merged Queries" = Table.NestedJoin(#"Changed Type", {"Symbol"}, AssetSubclass, {"Symbol"}, "AssetSubclass", JoinKind.LeftOuter),
				    #"Expanded AssetSubclass" = Table.ExpandTableColumn(#"Merged Queries", "AssetSubclass", {"AssetSubclass"}, {"AssetSubclass.1"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Expanded AssetSubclass",{{"AssetSubclass.1", "AssetSubclass"}}),
