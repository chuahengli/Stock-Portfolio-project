	partition CurrentHoldings = calculated
		mode: import
		source =
				
				VAR LastDay = CALCULATE(MAX(fact_positions[Date]), ALL(dim_symbol))
				RETURN
				    CALCULATETABLE(
				        fact_positions,
				        fact_positions[Date] = LastDay
				    )

	annotation PBI_Id = 3fa5975755a64ac48c236821a15b5217

